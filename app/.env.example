# Notion API Configuration
# Create an internal connection at https://www.notion.so/my-integrations
# (redirects to https://www.notion.so/developers/connections) and copy
# its "Installation access token" from the Configuration tab
NOTION_TOKEN=secret_xxx

# The ID of the Notion database where habit entries are created
# You can find this in the URL when viewing your database
# Example: https://notion.so/your-workspace/DATABASE_ID?v=...
NOTION_DATABASE_ID=database_id_xxx

# Timezone for time calculations (IANA timezone format)
# Examples: America/New_York, Europe/London, Asia/Tokyo, UTC
# This affects when habits are scheduled and time calculations
TIMEZONE=Asia/Tokyo

# Optional: Log level for debugging
# Uncomment and set to debug, info, warn, or error
# LOG_LEVEL=info
